{
  "name": "@qontinui/design-kit",
  "version": "0.1.1",
  "description": "Design-language compiler, exclusive Tailwind v4 theme, state-complete component kit and specimen for Qontinui-built products",
  "type": "module",
  "private": false,
  "license": "MIT",
  "author": "Joshua Spinak",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./specimen": {
      "types": "./dist/specimen/render.d.ts",
      "import": "./dist/specimen/render.js"
    }
  },
  "bin": {
    "design-kit": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "pretest": "npm run build",
    "test": "node --test --test-concurrency=1 --test-timeout=600000 \"test/**/*.test.js\""
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@qontinui/ui-bridge": "0.54.0",
    "@qontinui/ui-bridge-headless": "0.7.0",
    "@qontinui/ui-bridge-wrapper": "0.12.0",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.0.0",
    "postcss": "^8.5.26",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.53.1"
  },
  "keywords": [
    "qontinui",
    "design-language",
    "design-tokens",
    "tailwind",
    "design-system"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/qontinui/qontinui-design-kit"
  },
  "bugs": {
    "url": "https://github.com/qontinui/qontinui-design-kit/issues"
  },
  "homepage": "https://github.com/qontinui/qontinui-design-kit#readme",
  "peerDependencies": {
    "@qontinui/ui-bridge": "0.54.0",
    "@qontinui/ui-bridge-headless": "0.7.0",
    "@qontinui/ui-bridge-wrapper": "0.12.0",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    },
    "@qontinui/ui-bridge": {
      "optional": true
    },
    "@qontinui/ui-bridge-wrapper": {
      "optional": true
    },
    "@qontinui/ui-bridge-headless": {
      "optional": true
    }
  }
}
