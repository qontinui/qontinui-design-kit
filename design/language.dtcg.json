{
  "$extensions": {
    "qontinui": {
      "name": "design-kit-specimen"
    }
  },
  "color": {
    "role": {
      "surface": {
        "$type": "color",
        "$extensions": {
          "qontinui": {
            "source": "undeclared"
          }
        }
      }
    }
  },
  "type": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$extensions": {
          "qontinui": {
            "source": "undeclared"
          }
        }
      }
    },
    "scale": {
      "sm": {
        "$type": "dimension",
        "$value": {
          "value": 13,
          "unit": "px"
        },
        "$extensions": {
          "qontinui": {
            "source": "authored(design-kit-example-source)"
          }
        }
      },
      "md": {
        "$type": "dimension",
        "$value": {
          "value": 15,
          "unit": "px"
        },
        "$extensions": {
          "qontinui": {
            "source": "authored(design-kit-example-source)"
          }
        }
      },
      "lg": {
        "$type": "dimension",
        "$value": {
          "value": 18,
          "unit": "px"
        },
        "$extensions": {
          "qontinui": {
            "source": "authored(design-kit-example-source)"
          }
        }
      },
      "xl": {
        "$type": "dimension",
        "$value": {
          "value": 24,
          "unit": "px"
        },
        "$extensions": {
          "qontinui": {
            "source": "authored(design-kit-example-source)"
          }
        }
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400,
        "$extensions": {
          "qontinui": {
            "source": "authored(design-kit-example-source)"
          }
        }
      },
      "strong": {
        "$type": "fontWeight",
        "$value": 600,
        "$extensions": {
          "qontinui": {
            "source": "authored(design-kit-example-source)"
          }
        }
      }
    },
    "leading": {
      "body": {
        "$type": "number",
        "$value": 1.4,
        "$extensions": {
          "qontinui": {
            "source": "authored(design-kit-example-source)"
          }
        }
      }
    }
  },
  "space": {
    "unit": {
      "$type": "dimension",
      "$value": {
        "value": 4,
        "unit": "px"
      },
      "$extensions": {
        "qontinui": {
          "source": "authored(design-kit-example-source)"
        }
      }
    },
    "scale": {
      "1": {
        "$type": "dimension",
        "$extensions": {
          "qontinui": {
            "source": "derived(spacing-multiple)",
            "derive": {
              "rule": "spacing-multiple",
              "base": 4,
              "multiple": 1,
              "unit": "px"
            }
          }
        }
      },
      "2": {
        "$type": "dimension",
        "$extensions": {
          "qontinui": {
            "source": "derived(spacing-multiple)",
            "derive": {
              "rule": "spacing-multiple",
              "base": 4,
              "multiple": 2,
              "unit": "px"
            }
          }
        }
      },
      "3": {
        "$type": "dimension",
        "$extensions": {
          "qontinui": {
            "source": "derived(spacing-multiple)",
            "derive": {
              "rule": "spacing-multiple",
              "base": 4,
              "multiple": 3,
              "unit": "px"
            }
          }
        }
      },
      "4": {
        "$type": "dimension",
        "$extensions": {
          "qontinui": {
            "source": "derived(spacing-multiple)",
            "derive": {
              "rule": "spacing-multiple",
              "base": 4,
              "multiple": 4,
              "unit": "px"
            }
          }
        }
      },
      "6": {
        "$type": "dimension",
        "$extensions": {
          "qontinui": {
            "source": "derived(spacing-multiple)",
            "derive": {
              "rule": "spacing-multiple",
              "base": 4,
              "multiple": 6,
              "unit": "px"
            }
          }
        }
      }
    },
    "radius": {
      "sm": {
        "$type": "dimension",
        "$value": {
          "value": 2,
          "unit": "px"
        },
        "$extensions": {
          "qontinui": {
            "source": "authored(design-kit-example-source)"
          }
        }
      },
      "md": {
        "$type": "dimension",
        "$value": {
          "value": 4,
          "unit": "px"
        },
        "$extensions": {
          "qontinui": {
            "source": "authored(design-kit-example-source)"
          }
        }
      }
    },
    "border": {
      "width": {
        "$type": "dimension",
        "$value": {
          "value": 1,
          "unit": "px"
        },
        "$extensions": {
          "qontinui": {
            "source": "authored(design-kit-example-source)"
          }
        }
      },
      "emphasis": {
        "$type": "dimension",
        "$value": {
          "value": 2,
          "unit": "px"
        },
        "$extensions": {
          "qontinui": {
            "source": "authored(design-kit-example-source)"
          }
        }
      }
    },
    "focus": {
      "width": {
        "$type": "dimension",
        "$value": {
          "value": 2,
          "unit": "px"
        },
        "$extensions": {
          "qontinui": {
            "source": "authored(design-kit-example-source)"
          }
        }
      },
      "offset": {
        "$type": "dimension",
        "$value": {
          "value": 2,
          "unit": "px"
        },
        "$extensions": {
          "qontinui": {
            "source": "authored(design-kit-example-source)"
          }
        }
      }
    }
  },
  "layout": {
    "breakpoint": {
      "md": {
        "$type": "dimension",
        "$value": {
          "value": 768,
          "unit": "px"
        },
        "$extensions": {
          "qontinui": {
            "source": "authored(design-kit-example-source)"
          }
        }
      }
    },
    "shell": {
      "bar": {
        "$type": "dimension",
        "$value": {
          "value": 48,
          "unit": "px"
        },
        "$extensions": {
          "qontinui": {
            "source": "authored(design-kit-example-source)"
          }
        }
      },
      "sidebar": {
        "$type": "dimension",
        "$value": {
          "value": 240,
          "unit": "px"
        },
        "$extensions": {
          "qontinui": {
            "source": "authored(design-kit-example-source)"
          }
        }
      }
    }
  },
  "motion": {
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": {
          "value": 120,
          "unit": "ms"
        },
        "$extensions": {
          "qontinui": {
            "source": "authored(design-kit-example-source)"
          }
        }
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [
          0.2,
          0,
          0,
          1
        ],
        "$extensions": {
          "qontinui": {
            "source": "authored(design-kit-example-source)"
          }
        }
      }
    }
  },
  "budgets": {
    "density": {
      "max_interactive_per_viewport": {
        "$type": "number",
        "$value": 24,
        "$extensions": {
          "qontinui": {
            "source": "authored(design-kit-example-source)"
          }
        }
      }
    },
    "first_viewport": {
      "max_text_blocks": {
        "$type": "number",
        "$value": 12,
        "$extensions": {
          "qontinui": {
            "source": "authored(design-kit-example-source)"
          }
        }
      }
    },
    "shell": {
      "max_pinned_share": {
        "$type": "number",
        "$value": 0.1,
        "$extensions": {
          "qontinui": {
            "source": "authored(design-kit-example-source)"
          }
        }
      }
    }
  },
  "thresholds": {
    "contrast": {
      "min_lightness_delta": {
        "$type": "number",
        "$value": 0.4,
        "$extensions": {
          "qontinui": {
            "source": "authored(design-kit-example-source)"
          }
        }
      }
    }
  },
  "exceptions": {
    "legacy-grid": {
      "$type": "string",
      "$value": "A grid the product keeps until its redesign.",
      "$extensions": {
        "qontinui": {
          "source": "declared"
        }
      }
    }
  }
}
